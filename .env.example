# Copy this file to .env and put your key in it. .env is git-ignored: never commit it.
GEMINI_API_KEY=your-ai-studio-key

# Optional overrides (all settings: novamart/config.py and the README's Configuration table)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
# NOVAMART_MIN_SCORE=0.60
# Thinking is off by default (0, as in the eval). Set a budget to turn it on,
# or leave it empty for the model's own default.
# GEMINI_THINKING_BUDGET=1024
